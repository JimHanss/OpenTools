{
  "name": "opentools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first, cross-platform-ready mind map editor.",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @opentools/web",
    "build": "npm run typecheck && npm run build --workspace @opentools/web",
    "preview": "npm run preview --workspace @opentools/web",
    "typecheck": "tsc -b",
    "lint": "oxlint apps packages",
    "test": "vitest run --exclude apps/web/src/editor/performance.test.ts && vitest run apps/web/src/editor/performance.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.0.0",
    "oxlint": "^1.71.0",
    "prettier": "^3.8.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.0.18"
  },
  "packageManager": "yarn@4.17.0+sha512.c2957de2f9025ab14d63b24d0d8be1f1655810e22c341042c27f7ecd017b180ec12db73d69ac366d71b304ef9f069349ce462de96f04f8f1da317f4f762c95ae"
}
